<div class="popup-background"></div>
<div class="popup-card">
    <div class="popup-card-header">
        <%= "Reset/Change Password" %>
    </div>
    <div class="popup-card-content">
      <%= form_with(url: idk what path this would be, method: :post, local: true) do |form| %>
        <%= form.password_field :password %>
        <%= form.confirm_password_field :confirm_password %>
        <%= form.submit 'Submit' %>

        <%# error message for if passwords do not match or password does not meet requirements or was their most recently used password%>
        <%= if flash[:error] %>
          <div style="color: red;" class "error-message">
            <%= flash[:error] %>
          </div>
        <%= end %>
      <%= end %>
    </div>
</div>


