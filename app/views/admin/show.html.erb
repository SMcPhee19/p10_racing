<h1>THIS IS THE ADMIN PAGE</h1>
<% @users.reject { |user| user.name.downcase == "guest" }.each do |user| %>
  <%= user.name %> <%= button_to "Reset Password", force_reset_password_path(user), method: :patch, data: { confirm: "Are you sure you want to reset this user's password?" }, class: 'btn btn-warning' %>
  <br>
<% end %>
